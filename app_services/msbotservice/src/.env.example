# teams-bot-final-product — complete environment variable reference.
#
# This is the ONLY place configuration should ever need to change. Every value
# this app reads comes from an environment variable (App Settings in Azure,
# or this file loaded via python-dotenv for local runs) — never a hardcoded
# URL, name, or key in code. If something needs to point somewhere else,
# change it here (or in the Function App's Application Settings), not in
# agent.py / function_app.py / frontend.py / Constants.py.
#
# Deployed instance: this project's own Function App, in its own resource
# group. Values marked (set) below are configured on a working, verified
# deployment; values marked (ACTION NEEDED) are not and need a real value
# filled in for your own environment.

# ---------------------------------------------------------------------------
# Bot Framework identity — a user-assigned managed identity (UAMI) shared with
# the Azure Bot resource's msaAppId. Do not regenerate these once set.
# ---------------------------------------------------------------------------
MicrosoftAppType=UserAssignedMSI
MicrosoftAppId=<this bot's app/client id>
MicrosoftAppTenantId=<this app's Entra tenant id>
AZURE_CLIENT_ID=<same as MicrosoftAppId>

# The microsoft-agents SDK's own MsalConnectionManager reads this exact
# "ServiceConnection" shape (via load_configuration_from_env in agent.py) -
# separate from the three settings above, which agent.py's own code reads
# directly. Both are required; this triple is SDK-internal naming, not
# something this project invented.
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__AUTHTYPE=UserManagedIdentity
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTID=<same as AZURE_CLIENT_ID>
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__TENANTID=<same as MicrosoftAppTenantId>

# ---------------------------------------------------------------------------
# APIM — the generate_otc (or equivalent) orchestrator pipeline. REQUIRED.
# ---------------------------------------------------------------------------
# Base URL of the APIM instance (no trailing slash, no path).
APIM_BASE_URL=https://<your-apim-instance>.azure-api.net
# (ACTION NEEDED) Your APIM subscription's primary key. Cannot be retrieved by
# an AI assistant (secret-retrieval is blocked by design) - get it yourself
# via Portal (APIM -> Subscriptions -> <your subscription> -> Show/copy key)
# or `az rest ... listSecrets`, then set it as an App Setting directly
# (Portal or `az functionapp config appsettings set`) - never paste the real
# key into chat.
APIM_SUBSCRIPTION_KEY=

# ---------------------------------------------------------------------------
# Storage — business data (documents, tracking table, conversation refs,
# queue). REQUIRED.
# ---------------------------------------------------------------------------
STORAGE_ACCOUNT_NAME=<your storage account name>
STORAGE_UPLOADS_CONTAINER=otc-uploads
STORAGE_GENERATED_CONTAINER=otc-generated
CONVERSATION_STORE_TABLE_NAME=ConversationReferences
TRACKING_TABLE_NAME=OtcRequestTracking
STORAGE_QUEUE_NAME=otc-request-queue
# Only set this if you want to auth storage via a connection string instead of
# the UAMI (DefaultAzureCredential). Leave blank to use managed identity (the
# recommended setup) - this is an escape hatch, not the normal path.
AZURE_STORAGE_CONNECTION_STRING=

# The queue trigger (function_app.py's process_queue_message) binds through a
# SEPARATE identity-based connection, "StorageConnection" - it must point at
# the SAME account as STORAGE_ACCOUNT_NAME above, via these three settings
# (not AzureWebJobsStorage, which is the Functions runtime's own storage
# account and is NOT this one).
StorageConnection__accountName=<same as STORAGE_ACCOUNT_NAME>
StorageConnection__credential=managedidentity
StorageConnection__clientId=<same as AZURE_CLIENT_ID>
StorageConnection__queueServiceUri=https://<same as STORAGE_ACCOUNT_NAME>.queue.core.windows.net

# ---------------------------------------------------------------------------
# This app's own base URL — used to build the Teams tab contentUrl / any
# self-referencing links. Set to this Function App's default hostname.
# ---------------------------------------------------------------------------
APP_BASE_URL=https://<your-function-app>.azurewebsites.net

# Minutes a browser-upload SAS token stays valid for (frontend.py's direct
# PUT to Blob Storage). OPTIONAL - default is fine for a demo.
UPLOAD_SAS_TTL_MINUTES=30

# ---------------------------------------------------------------------------
# Storage toggle — true routes document storage/retrieval through SharePoint
# (Microsoft Graph), false (default) through Blob Storage. OPTIONAL. Both
# modes are fully verified end-to-end (real upload, real generate_otc run,
# real generated .docx landing in the chosen store) - Blob is the live
# default on the deployed app; SharePoint works but was switched off after
# testing since Blob was chosen as the default.
# ---------------------------------------------------------------------------
USE_SHAREPOINT=false
# IMPORTANT: USE_SHAREPOINT only selects where DOCUMENT FILES are stored (Blob
# vs SharePoint). The SharePoint tracking LIST below is independent of this
# toggle - it is written to, and searched, in BOTH storage modes whenever
# SHAREPOINT_SITE_ID/TENANT_ID/CLIENT_ID/CLIENT_SECRET are all set (see
# agent.py::_sharepoint_configured()). Leave those blank to disable the list
# entirely; set them to track every request in SharePoint regardless of
# USE_SHAREPOINT.
#
# Required for the list (see above) and, additionally, for document storage
# when USE_SHAREPOINT=true. Verified end-to-end against a real site.
SHAREPOINT_SITE_URL=https://<your-tenant>.sharepoint.com/sites/<your-site>
# Raw Graph site ID ("host,siteGuid,webGuid") - distinct from SHAREPOINT_SITE_URL,
# needed for the Lists API.
SHAREPOINT_SITE_ID=<your-tenant>.sharepoint.com,<site-guid>,<web-guid>
# Display name of the SharePoint LIST (not the document library) that tracks
# requests - the "own SharePoint list" from the original spec, separate from
# the document library below. Auto-created with this name + a matching column
# set on first use if it doesn't already exist - no manual list setup needed.
SHAREPOINT_LIST_NAME=OTC Requests
SHAREPOINT_DRIVE_ID=<your drive id, from Graph>

# If the SharePoint site lives in a DIFFERENT Entra tenant than this app's own
# UAMI/tenant, a managed identity cannot cross that boundary - the SharePoint
# branch (only) then needs its own tenant-scoped app registration instead.
# Confirm via tenant discovery, don't assume. Leave blank for same-tenant use.
SHAREPOINT_TENANT_ID=<the SharePoint site's own tenant id, if different from MicrosoftAppTenantId>
SHAREPOINT_CLIENT_ID=<app registration client id, scoped to this one site via Sites.Selected>
# (set directly as an app setting by the user - not reproduced here) The app
# was granted Sites.Selected -> write access scoped to just this one site via
# POST /sites/{siteId}/permissions (not tenant-wide Sites.ReadWrite.All).
SHAREPOINT_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Azure Functions runtime plumbing — standard, not project-specific.
# AzureWebJobsStorage is the Functions runtime's OWN storage account (a
# dedicated runtime account - NOT the business-data account above) and is
# set as a connection string (Azure's own default for a new Function App) -
# its value is a credential, so it is intentionally not reproduced here. Get
# it via Portal -> your Function App -> Configuration; never print it in a
# terminal or chat.
# ---------------------------------------------------------------------------
FUNCTIONS_WORKER_RUNTIME=python
FUNCTIONS_EXTENSION_VERSION=~4
AzureWebJobsStorage=<connection string for this Function App's own runtime storage account - set via Portal, not reproduced here>
APPLICATIONINSIGHTS_CONNECTION_STRING=<App Insights connection string for this app's telemetry - see Portal>

